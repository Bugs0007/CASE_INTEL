  "cards": [
    {
      "dot": "amber",
      "title": "Postgres is the queue",
      "items": [
        "No Celery or Redis: views enqueue ProcessingJob rows",
        "The worker claims them with select_for_update(skip_locked)"
      ]
    },
    {
      "dot": "violet",
      "title": "Two AI axes",
      "items": [
        "LLM via get_llm_client(): Groq, Ollama or OpenAI",
        "Embeddings: Gemini or Ollama, fixed at 768-d"
      ]
    },
    {
      "dot": "rose",
      "title": "Guardrails",
      "items": [
        "Token auth; every queryset is owner-scoped",
        "Tracking refresh hits eCourts inline, max once per case per hour"
      ]
    }
