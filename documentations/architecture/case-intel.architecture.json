          "web",
          "api",
          "db"
        ],
        "note": "Browser to Vercel to the DRF API on EC2, every query owner-scoped, state in RDS Postgres."
      },
      {
        "id": "job-queue",
        "label": "Postgres job queue",
        "focus": [
          "api",
          "db",
          "worker",
          "ai",
          "courts"
        ],
        "note": "Views enqueue ProcessingJob rows; one worker claims them with skip_locked and does the slow calls."
      },
      {
        "id": "cause-lists",
        "label": "Cause-list schedule",
        "focus": [
          "timer",
          "courts",
          "db"
        ],
        "note": "A per-court systemd timer fetches cause-list PDFs at 19:00 and 06:30 and matches them to hearings."
      },
      {
        "id": "outbound",
        "label": "Files and email",
        "focus": [
          "api",
          "s3",
          "resend"
        ],
        "note": "Documents and order PDFs go to S3 (or local disk); invoice email goes out through Resend when configured."
      }
    ],
